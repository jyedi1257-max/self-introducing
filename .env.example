# Firebase 웹 앱 설정 (Firebase Console > 프로젝트 설정 > 내 앱)
# 이 값들은 공개되어도 되는 값이다. 실제 보호는 App Check 와 Security Rules 가 한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise 사이트 키)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# 개발용 App Check 디버그 토큰.
# 운영 reCAPTCHA 설정에 localhost 를 넣지 말고, 이 토큰을 Firebase Console 에 등록한다.
VITE_APPCHECK_DEBUG_TOKEN=
