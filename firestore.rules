rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    // 단어 목록은 누구나 읽고, 교사만 고칠 수 있다.
    match /words/{wordId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // 학생이 제안한 단어. 본인과 교사만 볼 수 있다.
    match /wordSuggestions/{suggestionId} {

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 15
        && (
          request.resource.data.type == "trait"
          || request.resource.data.type == "character"
        );

      allow read: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || isTeacher()
        );

      allow update: if isTeacher();

      allow delete: if isTeacher()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == "pending"
        );
    }

    // 관리자 문서는 Firebase Console 에서만 만든다.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
