{
  "name": "two-words-self-intro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "seed": "node scripts/seedWords.mjs",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project two-words-rules-test \"vitest run\"",
    "test": "npm run test:rules"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.0"
  }
}
